@using Fruit_Store.Core.DTOs
@model ProductDTO

@{
    ViewData["Title"] = Model?.Name ?? "Product";
    var reviews = ViewBag.Reviews as IEnumerable<ReviewDTO> ?? Enumerable.Empty<ReviewDTO>();
}

<!-- search area -->
<div class="search-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<span class="close-btn"><i class="fas fa-window-close"></i></span>
				<div class="search-bar">
					<div class="search-bar-tablecell">
						<h3>Search For:</h3>
						<input type="text" placeholder="Keywords">
						<button type="submit">Search <i class="fas fa-search"></i></button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end search area -->
<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 offset-lg-2 text-center">
				<div class="breadcrumb-text">
					<p>See more Details</p>
					<h1>@Model?.Name</h1>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end breadcrumb section -->
<!-- single product -->
<div class="single-product mt-150 mb-150">
	<div class="container">
		<div class="row">
			<div class="col-md-5">
				<div class="single-product-img">
					@if (!string.IsNullOrEmpty(Model?.ImageUrl))
					{
						<img src="~/Images/Products/@Model.ImageUrl.Replace("Images/Products/", "")"
						     onerror="this.src='/assets/img/product-placeholder.jpg'"
						     alt="@Model.Name">
					}
				</div>
			</div>
			<div class="col-md-7">
				<div class="single-product-content">
					<h3>@Model?.Name</h3>
					<p class="single-product-pricing"><span>Per Kg</span> $@Model?.Price.ToString("0.00")</p>
					<p>@Model?.Description</p>

					@if (Model?.Quantity > 0)
					{
						<div class="single-product-form">
							<form asp-controller="Cart" asp-action="AddToCart" method="post">
								@Html.AntiForgeryToken()
								<input type="hidden" name="productId" value="@Model.Id" />
								<input type="number" name="quantity" value="1" min="1" max="@Model.Quantity" placeholder="Qty">
								<button type="submit" class="cart-btn">
									<i class="fas fa-shopping-cart"></i> Add to Cart
								</button>
							</form>
							<p style="margin-top:8px; color:#777;"><small>@Model.Quantity units available</small></p>
						</div>
					}
					else
					{
						<p class="cart-btn" style="opacity:0.5; cursor:not-allowed; display:inline-block;">
							Out of Stock
						</p>
					}

					<h4>Share:</h4>
					<ul class="product-share">
						<li><a href="#"><i class="fab fa-facebook-f"></i></a></li>
						<li><a href="#"><i class="fab fa-twitter"></i></a></li>
						<li><a href="#"><i class="fab fa-google-plus-g"></i></a></li>
						<li><a href="#"><i class="fab fa-linkedin"></i></a></li>
					</ul>
				</div>
			</div>
		</div>

		@if (reviews.Any())
		{
			<div class="row mt-5">
				<div class="col-12">
					<h3>Customer Reviews</h3>
					<hr>
					@foreach (var review in reviews)
					{
						<div style="background:#f9f9f9; border-radius:8px; padding:15px; margin-bottom:12px;">
							<p style="margin:0;">@review.Text</p>
							<small style="color:#999;">@review.CreatedDate?.ToString("MMM dd, yyyy")</small>
						</div>
					}
				</div>
			</div>
		}
	</div>
</div>
<!-- end single product -->
<!-- logo carousel -->
<div class="logo-carousel-section">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="logo-carousel-inner">
					<div class="single-logo-item"><img src="~/Images/company logos/1.png" alt=""></div>
					<div class="single-logo-item"><img src="~/Images/company logos/2.png" alt=""></div>
					<div class="single-logo-item"><img src="~/Images/company logos/3.png" alt=""></div>
					<div class="single-logo-item"><img src="~/Images/company logos/4.png" alt=""></div>
					<div class="single-logo-item"><img src="~/Images/company logos/5.png" alt=""></div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end logo carousel -->
