@using Fruit_Store.Core.DTOs
@model IEnumerable<ProductDTO>

@{
    ViewData["Title"] = "Shop";
    var categories = ViewBag.Categories as IEnumerable<CategoryDTO> ?? Enumerable.Empty<CategoryDTO>();
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<!-- search area -->
<div class="search-area">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<span class="close-btn"><i class="fas fa-window-close"></i></span>
				<div class="search-bar">
					<div class="search-bar-tablecell">
						<h3>Search For:</h3>
						<input type="text" placeholder="Keywords">
						<button type="submit">Search <i class="fas fa-search"></i></button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end search area -->
<!-- breadcrumb-section -->
<div class="breadcrumb-section breadcrumb-bg">
	<div class="container">
		<div class="row">
			<div class="col-lg-8 offset-lg-2 text-center">
				<div class="breadcrumb-text">
					<p>Fresh and Organic</p>
					<h1>Shop</h1>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end breadcrumb section -->
<!-- products -->
<div class="product-section mt-150 mb-150">
	<div class="container">

		<div class="row">
			<div class="col-md-12">
				<div class="product-filters">
					<ul>
						<li class="@(selectedCategoryId == null ? "active" : "")">
							<a asp-controller="Shop" asp-action="Index" style="text-decoration:none; color:inherit;">All</a>
						</li>
						@foreach (var cat in categories)
						{
							<li class="@(selectedCategoryId == cat.Id ? "active" : "")">
								<a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@cat.Id"
								   style="text-decoration:none; color:inherit;">@cat.Name</a>
							</li>
						}
					</ul>
				</div>
			</div>
		</div>

		<div class="row product-lists">
			@if (!Model.Any())
			{
				<div class="col-12 text-center mt-4">
					<p>No products found in this category.</p>
					<a asp-controller="Shop" asp-action="Index" class="boxed-btn">View All Products</a>
				</div>
			}
			else
			{
				@foreach (var product in Model)
				{
					<div class="col-lg-4 col-md-6 text-center">
						<div class="single-product-item">
							<div class="product-image">
								<a asp-controller="SingleProduct" asp-action="Index" asp-route-id="@product.Id">
									<img src="~/Images/Products/@product.ImageUrl?.Replace("Images/Products/", "")"
									     onerror="this.src='/assets/img/product-placeholder.jpg'"
									     alt="@product.Name">
								</a>
							</div>
							<h3>@product.Name</h3>
							<p class="product-price"><span>Per Kg</span> $@product.Price.ToString("0.00")</p>
							@if (product.Quantity > 0)
							{
								<form asp-controller="Cart" asp-action="AddToCart" method="post" style="display:inline;">
									@Html.AntiForgeryToken()
									<input type="hidden" name="productId" value="@product.Id" />
									<input type="hidden" name="quantity" value="1" />
									<button type="submit" class="cart-btn">
										<i class="fas fa-shopping-cart"></i> Add to Cart
									</button>
								</form>
							}
							else
							{
								<span class="cart-btn" style="opacity:0.5; cursor:not-allowed;">Out of Stock</span>
							}
						</div>
					</div>
				}
			}
		</div>

	</div>
</div>
<!-- end products -->
<!-- logo carousel -->
<div class="logo-carousel-section">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="logo-carousel-inner">
					<div class="single-logo-item">
						<img src="~/Images/company logos/1.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="~/Images/company logos/2.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="~/Images/company logos/3.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="~/Images/company logos/4.png" alt="">
					</div>
					<div class="single-logo-item">
						<img src="~/Images/company logos/5.png" alt="">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end logo carousel -->
