@using Fruit_Store.Core.DTOs
@using FruitStore.Core.Enums
@model IEnumerable<OrderDTO>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Orders";
}

<h2><i class="fas fa-shopping-bag"></i> All Orders</h2>
<hr>

<div class="card">
    <div class="card-body">
        @if (!Model.Any())
        {
            <p>No orders found.</p>
        }
        else
        {
            <table class="table table-hover admin-table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Shipping To</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.OrderByDescending(x => x.OrderDate))
                    {
                        <tr>
                            <td>#@o.Id</td>
                            <td>@o.OrderDate.ToString("MMM dd, yyyy")</td>
                            <td><small>@(o.UserId ?? "N/A")</small></td>
                            <td>@o.ShippingName, @o.ShippingCity</td>
                            <td>$@o.TotalAmount.ToString("0.00")</td>
                            <td>
                                @{
                                    var badgeClass = o.Status switch {
                                        OrderStatus.Pending => "badge-warning",
                                        OrderStatus.Processing => "badge-info",
                                        OrderStatus.Shipped => "badge-primary",
                                        OrderStatus.Delivered => "badge-success",
                                        OrderStatus.Cancelled => "badge-danger",
                                        _ => "badge-secondary"
                                    };
                                }
                                <span class="badge @badgeClass">@o.Status</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-info">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <form asp-action="UpdateStatus" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@o.Id" />
                                    <select name="newStatus" class="form-control-sm" style="display:inline; width:120px;"
                                            onchange="this.form.submit()">
                                        @foreach (var status in Enum.GetValues<OrderStatus>())
                                        {
                                            if (o.Status == status)
                                            {
                                                <option value="@status" selected>@status</option>
                                            }
                                            else
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        }
                                    </select>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
