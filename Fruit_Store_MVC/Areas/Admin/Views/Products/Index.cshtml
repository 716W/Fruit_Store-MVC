@using Fruit_Store.Core.DTOs
@model IEnumerable<ProductDTO>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-apple-alt"></i> Products</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Add Product</a>
</div>
<hr>

<div class="card">
    <div class="card-body">
        <table class="table table-hover admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Name</td>
                        <td>$@p.Price.ToString("0.00")</td>
                        <td>
                            @if (p.Quantity == 0)
                            {
                                <span class="badge badge-danger">Out of Stock</span>
                            }
                            else if (p.Quantity <= 10)
                            {
                                <span class="badge badge-warning">@p.Quantity (Low)</span>
                            }
                            else
                            {
                                <span class="badge badge-success">@p.Quantity</span>
                            }
                        </td>
                        <td>@p.CategoryId</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger ml-1">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
