@using Fruit_Store.Core.DTOs
@model IEnumerable<CategoryDTO>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fas fa-tags"></i> Categories</h2>
    <a asp-action="Create" class="btn btn-success"><i class="fas fa-plus"></i> Add Category</a>
</div>
<hr>

<div class="card">
    <div class="card-body">
        <table class="table table-hover admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>
                        <td>@c.Name</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-primary">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger ml-1">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
