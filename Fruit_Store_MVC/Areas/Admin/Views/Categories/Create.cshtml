@using Fruit_Store.Core.DTOs
@model CategoryDTO
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Category";
}

<h2><i class="fas fa-plus"></i> Create Category</h2>
<hr>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="form-group">
                <label asp-for="Name">Category Name</label>
                <input asp-for="Name" class="form-control" required maxlength="100" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Create</button>
            <a asp-action="Index" class="btn btn-secondary ml-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
